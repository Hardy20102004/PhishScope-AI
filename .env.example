# PhishScope-AI / PHOENIX Environment Configuration
# ===============================================

# Application
ENVIRONMENT=development
# Generate a strong key for production: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# For local no-docker dev, this will fallback to SQLite if not set properly in run_phishscope.py
POSTGRES_SERVER=localhost
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=password
POSTGRES_DB=phoenix
# Full URI override if needed
# SQLALCHEMY_DATABASE_URI=postgresql://phoenix:password@localhost/phoenix

# Redis (Task queue and caching)
REDIS_URL=redis://localhost:6379/0

# Admin Credentials (Created on first run)
# WARNING: Change the password immediately after logging in!
ADMIN_EMAIL=admin@phoenix.ai
ADMIN_PASSWORD=Phoenix@Admin123

# External APIs (Optional depending on active modules)
# VIRUSTOTAL_API_KEY=
# OPENCTI_URL=
# OPENCTI_TOKEN=
# MISP_URL=
# MISP_KEY=
